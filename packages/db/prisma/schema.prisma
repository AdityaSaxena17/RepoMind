generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum RepositoryVisibility {
  PUBLIC
  PRIVATE
  INTERNAL
}

enum RepositoryAccessStatus {
  ACTIVE
  REVOKED
}

enum RepositoryIndexStatus {
  NOT_INDEXED
  INDEXING
  UPDATING
  READY
  FAILED
}

enum RepositoryIndexJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum RepositoryIndexJobTrigger {
  CONNECT
  RETRY
  PUSH
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

enum ChatMessageStatus {
  PENDING
  STREAMING
  SUCCEEDED
  FAILED
}

model User {
  id         String     @id @default(cuid())
  clerkId    String     @unique
  email      String?
  firstName  String?
  lastName   String?
  username   String?
  imageUrl   String?
  status     UserStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  inactiveAt DateTime?

  repositories UserRepository[]
  chatConversations ChatConversation[]

  @@index([status])
}

model Repository {
  id                   String                @id @default(cuid())
  githubRepositoryId   String                @unique
  owner                String
  name                 String
  fullName             String
  visibility           RepositoryVisibility
  defaultBranch        String
  archived             Boolean               @default(false)
  htmlUrl              String?
  accessStatus         RepositoryAccessStatus @default(ACTIVE)
  indexStatus          RepositoryIndexStatus  @default(NOT_INDEXED)
  indexProgress        Int                   @default(0)
  indexedCommitSha     String?
  targetCommitSha      String?
  indexedFileCount     Int                   @default(0)
  indexedChunkCount    Int                   @default(0)
  lastIndexedAt        DateTime?
  lastIndexError       String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  files                RepositoryFile[]
  chunks               RepositoryChunk[]
  indexJobs            RepositoryIndexJob[]
  users                UserRepository[]
  chatConversations    ChatConversation[]

  @@index([owner, name])
  @@index([indexStatus])
  @@index([accessStatus])
}

model UserRepository {
  id           String                 @id @default(cuid())
  userId       String
  repositoryId String
  accessStatus RepositoryAccessStatus @default(ACTIVE)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  repository   Repository             @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryId])
  @@index([repositoryId])
  @@index([accessStatus])
}

model RepositoryIndexJob {
  id              String                   @id @default(cuid())
  repositoryId    String
  trigger         RepositoryIndexJobTrigger
  status          RepositoryIndexJobStatus @default(QUEUED)
  sourceCommitSha String?
  targetCommitSha String?
  progress        Int                      @default(0)
  errorMessage    String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  repository      Repository               @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, status])
  @@index([createdAt])
}

model RepositoryFile {
  id           String     @id @default(cuid())
  repositoryId String
  path         String
  blobSha      String
  contentSha   String
  byteSize     Int
  lineCount    Int
  content      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  chunks       RepositoryChunk[]
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, path])
  @@index([repositoryId, blobSha])
}

model RepositoryChunk {
  id           String                  @id @default(cuid())
  repositoryId String
  fileId       String
  chunkIndex   Int
  path         String
  startLine    Int
  endLine      Int
  content      String
  contentSha   String
  embedding    Unsupported("vector(1536)")
  createdAt    DateTime                @default(now())
  file         RepositoryFile          @relation(fields: [fileId], references: [id], onDelete: Cascade)
  repository   Repository              @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([fileId, chunkIndex])
  @@index([repositoryId, path])
}

model ChatConversation {
  id           String        @id @default(cuid())
  userId       String
  repositoryId String
  title        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     ChatMessage[]
  repository   Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, repositoryId, updatedAt])
  @@index([repositoryId])
}

model ChatMessage {
  id             String                @id @default(cuid())
  conversationId String
  role           ChatMessageRole
  content        String
  status         ChatMessageStatus     @default(SUCCEEDED)
  errorMessage   String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  citations      ChatMessageCitation[]
  conversation   ChatConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([status])
}

model ChatMessageCitation {
  id          String      @id @default(cuid())
  messageId   String
  sourceIndex Int
  path        String
  startLine   Int
  endLine     Int
  url         String?
  createdAt   DateTime    @default(now())
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, sourceIndex])
}
