{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "python scripts/uv_run.py python -m compileall -q app",
    "check-types": "python scripts/uv_run.py mypy app",
    "dev": "python scripts/uv_run.py uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "lint": "python scripts/uv_run.py ruff check app tests",
    "lock": "python scripts/uv_lock.py",
    "test": "python scripts/uv_run.py pytest -p no:cacheprovider",
    "worker": "python scripts/uv_run.py arq app.worker.WorkerSettings"
  }
}
