REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
ARQ_QUEUE_NAME=repomind:indexing
API_DATABASE_URL=postgresql://repomind:repomind_password@localhost:5433/RepoMind
OPENAI_API_KEY=sk_your_openai_api_key
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
# Optional local reranker; install the rerank extra before selecting qwen3.
REPOSITORY_RERANKER=none
# Separate database/role; never point this at the application database.
EVAL_DATABASE_URL=postgresql://repomind_eval:replace_with_eval_password@localhost:5433/repomind_eval
