REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
ARQ_QUEUE_NAME=repomind:indexing
API_DATABASE_URL=postgresql://repomind:repomind_password@localhost:5433/RepoMind
# Optional locally; when configured, use the same value in apps/web/.env.
INTERNAL_API_CREDENTIAL=
# Shared by repository indexing and GitHub MCP; optional for public reads.
GITHUB_TOKEN=github_pat_optional_public_read_token
# Local Qwen embeddings need Ollama and ollama pull qwen3-embedding:0.6b.
EMBEDDINGS_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional legacy embeddings for paired experiments: EMBEDDINGS_PROVIDER=openai.
OPENAI_API_KEY=sk_your_openai_api_key
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
# Legacy chat provider, used only when HIVE_API_KEY is not configured.
OPENAI_CHAT_MODEL=gpt-4o-mini
# Shared Hive credential for LangChain inference and evaluation judging.
HIVE_API_KEY=your_hive_api_key
HIVE_CHAT_MODEL=deepseek-ai/deepseek-v4.1-flash
# Disabled to avoid reranking latency; retain the opt-in for later experiments.
REPOSITORY_RERANKER=none
AGENT_TOOL_CALL_LIMIT=6
AGENT_MODEL_CALL_LIMIT=8
AGENT_TIMEOUT_SECONDS=120
# Exact indexed code searches/windows only; 0 disables shared context caching.
CODE_CONTEXT_CACHE_TTL_SECONDS=900
# REPOSITORY_RERANKER=qwen3
# Separate database/role; never point this at the application database.
EVAL_DATABASE_URL=postgresql://repomind_eval:replace_with_eval_password@localhost:5433/repomind_eval
