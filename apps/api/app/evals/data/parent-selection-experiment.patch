+def candidate(path: str, first: int, last: int, score: float) -> dict[str, object]:
+    return dict(
+        id=f"{path}:{first}:{last}",
+        file_id=path,
+        path=path,
+        start_line=first,
+        end_line=last,
+        score=score,
+        sources={"vector"},
+    )
