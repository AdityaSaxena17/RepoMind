+async def parents(
+    candidates: list[dict[str, object]],
+    contents: dict[str, str],
+) -> list[Document]:
+    class Connection:
+        async def fetch(self, _sql: str, *_args: object) -> list[dict[str, object]]:
+            return [
+                dict(
+                    id=path,
+                    path=path,
+                    content=content,
+                    lineCount=len(content.splitlines()),
+                )
+                for path, content in contents.items()
+            ]
+
+    retriever = RepoMindParentHybridRetriever.model_construct(
+        connection=Connection(), embeddings=None, repository_id="test"
+    )
+    return await retriever._parent_documents(candidates)
