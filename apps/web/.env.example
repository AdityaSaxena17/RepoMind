NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_webhook_signing_secret
DATABASE_URL=postgresql://repomind:repomind_password@localhost:5433/RepoMind?schema=public
FASTAPI_BASE_URL=http://127.0.0.1:8137
# Optional locally; when configured, use the same value in apps/api/.env.
INTERNAL_API_CREDENTIAL=
GITHUB_TOKEN=github_pat_optional_public_read_token

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Configure Hive, embeddings, reranking and the evaluation database in apps/api/.env.
# The web app forwards chat requests to FASTAPI_BASE_URL.
