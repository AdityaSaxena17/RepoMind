NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_webhook_signing_secret
DATABASE_URL=postgresql://repomind:repomind_password@localhost:5433/RepoMind?schema=public
API_DATABASE_URL=postgresql://repomind:repomind_password@localhost:5433/RepoMind
FASTAPI_BASE_URL=http://127.0.0.1:8137
INTERNAL_API_CREDENTIAL=replace_with_a_shared_random_service_secret
GITHUB_TOKEN=github_pat_optional_public_read_token

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Server-side API configuration; never prefix these keys with NEXT_PUBLIC_.
# Local embeddings default to Qwen through Ollama; OpenAI is an explicit fallback.
EMBEDDINGS_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_API_KEY=sk_your_openai_api_key
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
HIVE_API_KEY=your_hive_api_key
HIVE_CHAT_MODEL=deepseek-ai/deepseek-v4.1-flash
